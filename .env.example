# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="MABRIG Content Engine"

# Database
DATABASE_URL=postgresql://mabrig:password@localhost:5432/mabrig_content_engine

# Redis
REDIS_URL=redis://localhost:6379

# Authentication
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-min-32-chars-change-in-production

# OAuth Providers
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# AI Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Social Platform Credentials
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Storage (S3/Cloudflare R2)
STORAGE_TYPE=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@mabrig.com

# Feature Flags
ENABLE_AI_FEATURES=true
ENABLE_CRM=true
ENABLE_ANALYTICS=true


# AI Video Studio
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
HF_TOKEN=
GOOGLE_VIDS_BRIDGE_ENABLED=false
GEMINI_API_KEY=
GEMINI_VEO_MODEL=veo-3.1-generate-preview
GEMINI_VEO_USD_PER_SECOND=
GEMINI_VEO_MAX_COST_USD=
RUNWAYML_API_SECRET=
RUNWAY_API_KEY=
RUNWAY_ROUTER_CONFIG_ID=
RUNWAY_MAX_CREDITS_PER_GENERATION=
EDENAI_API_KEY=
COMETAPI_API_KEY=
VIDEO_ROUTER_PAID_FALLBACK=false
VIDEO_ROUTER_MAX_COST_USD=0
VIDEO_EXECUTION_ENABLED=false
VIDEO_EXECUTION_TOKEN=
MONGODB_URI=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mabrig-verse
GPU_WORKER_URL=
GPU_WORKER_TOKEN=
VIDEO_GENERATION_EXECUTABLE=
VIDEO_GENERATION_TIMEOUT_SECONDS=900
META_APP_ID=
META_APP_SECRET=
WEBSITE_PUBLISH_URL=
WEBSITE_PUBLISH_TOKEN=
# Video execution approvals / artifact persistence
VIDEO_APPROVAL_TOKEN=
VIDEO_APPROVAL_SECRET=
VIDEO_ARTIFACT_MAX_BYTES=536870912
VIDEO_ARTIFACT_ALLOWED_HOSTS=
GPU_WORKER_PUBLIC_URL=
VIDEO_OUTPUT_DIR=/data/outputs
WAN_MODEL_ID=Wan-AI/Wan2.1-T2V-1.3B-Diffusers
WAN_CPU_OFFLOAD=true
WAN_NUM_FRAMES=81
WAN_FPS=16
WAN_STEPS=30
WAN_GUIDANCE_SCALE=5.0
WAN_SEED=42
