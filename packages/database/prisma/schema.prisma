// This is your Prisma schema file
// MABRIG Content Engine Database Schema

generator client {
  provider      = "prisma-client-js"
  output        = "../../../node_modules/@prisma/client"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTHENTICATION & USERS
// ============================================================

model User {
  id            String     @id @default(cuid())
  email         String     @unique
  emailVerified DateTime?
  name          String?
  image         String?
  role          UserRole   @default(CREATOR)
  status        UserStatus @default(ACTIVE)

  // Auth
  password String?
  accounts Account[]
  sessions Session[]

  // Workspace
  ownedWorkspaces      Workspace[]       @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[]

  // Activity
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  CREATOR
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================================
// WORKSPACES (Multi-tenant)
// ============================================================

model Workspace {
  id   String @id @default(cuid())
  name String
  slug String @unique
  logo String?
  plan Plan   @default(FREE)

  ownerId String
  owner   User   @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  members WorkspaceMember[]

  // Content
  socialAccounts SocialAccount[]
  posts          Post[]
  mediaItems     MediaItem[]
  contacts       Contact[]
  automations    Automation[]
  tags           Tag[]

  // Settings
  settings Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("workspaces")
}

enum Plan {
  FREE
  STARTER
  PRO
  AGENCY
  ENTERPRISE
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, userId])
  @@map("workspace_members")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  MEMBER
  VIEWER
}

// ============================================================
// SOCIAL ACCOUNTS
// ============================================================

model SocialAccount {
  id          String         @id @default(cuid())
  workspaceId String
  platform    SocialPlatform
  accountId   String
  accountName String
  username    String?
  avatar      String?

  // OAuth tokens
  accessToken  String   @db.Text
  refreshToken String?  @db.Text
  tokenExpiry  DateTime?
  scopes       String[]

  // Account metadata
  metadata Json?
  isActive Boolean @default(true)

  workspace Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  posts     PostSocialAccount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, platform, accountId])
  @@map("social_accounts")
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  TWITTER
  LINKEDIN
  TIKTOK
  YOUTUBE
  PINTEREST
  THREADS
  TELEGRAM
}

// ============================================================
// POSTS & CONTENT
// ============================================================

model Post {
  id          String @id @default(cuid())
  workspaceId String

  // Content
  title           String?
  content         String  @db.Text
  contentVariants Json? // Platform-specific content variants

  // Media
  mediaItems PostMedia[]

  // Scheduling
  status      PostStatus @default(DRAFT)
  scheduledAt DateTime?
  publishedAt DateTime?

  // Social accounts to post to
  socialAccounts PostSocialAccount[]

  // AI metadata
  aiGenerated Boolean @default(false)
  aiPrompt    String? @db.Text
  aiModel     String?

  // Tags & Categories
  tags PostTag[]

  // Analytics
  analytics PostAnalytics?

  // Workflow
  approvalStatus ApprovalStatus @default(NOT_REQUIRED)
  approvedBy     String?
  approvedAt     DateTime?
  notes          String?        @db.Text

  // Recycling
  isEvergreen   Boolean @default(false)
  recycleConfig Json?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("posts")
}

enum PostStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  ARCHIVED
}

enum ApprovalStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

model PostSocialAccount {
  id              String @id @default(cuid())
  postId          String
  socialAccountId String

  // Platform-specific content
  content String? @db.Text

  // Publishing result
  status         PostStatus @default(DRAFT)
  externalPostId String?
  publishedAt    DateTime?
  errorMessage   String?

  post          Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccount SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([postId, socialAccountId])
  @@map("post_social_accounts")
}

model PostMedia {
  id      String @id @default(cuid())
  postId  String
  mediaId String
  order   Int    @default(0)

  post  Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  media MediaItem @relation(fields: [mediaId], references: [id])

  @@map("post_media")
}

model PostTag {
  postId String
  tagId  String

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("post_tags")
}

// ============================================================
// MEDIA LIBRARY
// ============================================================

model MediaItem {
  id          String @id @default(cuid())
  workspaceId String

  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  thumbnailUrl String?

  type     MediaType
  width    Int?
  height   Int?
  duration Float? // For videos in seconds

  // AI metadata
  altText String?
  caption String?
  aiTags  String[]

  // Storage
  storageKey  String
  storageType String @default("local")

  workspace Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  posts     PostMedia[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("media_items")
}

enum MediaType {
  IMAGE
  VIDEO
  GIF
  AUDIO
  DOCUMENT
}

// ============================================================
// ANALYTICS
// ============================================================

model PostAnalytics {
  id     String @id @default(cuid())
  postId String @unique

  // Engagement
  impressions Int   @default(0)
  reach       Int   @default(0)
  likes       Int   @default(0)
  comments    Int   @default(0)
  shares      Int   @default(0)
  saves       Int   @default(0)
  clicks      Int   @default(0)

  // Computed
  engagementRate Float @default(0)

  // Platform breakdown (JSON)
  platformData Json?

  lastSyncedAt DateTime?

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@map("post_analytics")
}

model AnalyticsSnapshot {
  id          String @id @default(cuid())
  workspaceId String

  date     DateTime       @db.Date
  platform SocialPlatform?

  // Metrics
  posts       Int @default(0)
  impressions Int @default(0)
  reach       Int @default(0)
  engagements Int @default(0)
  followers   Int @default(0)

  createdAt DateTime @default(now())

  @@unique([workspaceId, date, platform])
  @@map("analytics_snapshots")
}

// ============================================================
// CRM - CONTACTS
// ============================================================

model Contact {
  id          String @id @default(cuid())
  workspaceId String

  firstName String?
  lastName  String?
  email     String?
  phone     String?
  avatar    String?

  // Social profiles
  socialProfiles Json?

  // Classification
  type      ContactType   @default(FOLLOWER)
  status    ContactStatus @default(ACTIVE)
  leadScore Int           @default(0)

  // Notes & metadata
  notes    String? @db.Text
  metadata Json?

  // Relations
  tags         ContactTag[]
  interactions ContactInteraction[]

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contacts")
}

enum ContactType {
  FOLLOWER
  LEAD
  CUSTOMER
  PARTNER
  COLLABORATOR
  INFLUENCER
}

enum ContactStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

model ContactInteraction {
  id        String          @id @default(cuid())
  contactId String
  type      InteractionType
  content   String?         @db.Text
  metadata  Json?

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("contact_interactions")
}

enum InteractionType {
  NOTE
  EMAIL
  COMMENT
  DM
  ENGAGEMENT
  PURCHASE
}

model ContactTag {
  contactId String
  tagId     String

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([contactId, tagId])
  @@map("contact_tags")
}

// ============================================================
// TAGS (Universal)
// ============================================================

model Tag {
  id          String @id @default(cuid())
  workspaceId String
  name        String
  color       String @default("#6366f1")

  posts    PostTag[]
  contacts ContactTag[]

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([workspaceId, name])
  @@map("tags")
}

// ============================================================
// AUTOMATIONS
// ============================================================

model Automation {
  id          String @id @default(cuid())
  workspaceId String
  name        String
  description String?

  trigger       AutomationTrigger
  triggerConfig Json?

  actions AutomationAction[]

  isActive  Boolean   @default(true)
  lastRunAt DateTime?
  runCount  Int       @default(0)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("automations")
}

enum AutomationTrigger {
  SCHEDULE
  NEW_FOLLOWER
  MENTION
  POST_PUBLISHED
  ENGAGEMENT_THRESHOLD
  WEBHOOK
  MANUAL
}

model AutomationAction {
  id           String     @id @default(cuid())
  automationId String
  type         ActionType
  config       Json
  order        Int        @default(0)

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@map("automation_actions")
}

enum ActionType {
  CREATE_POST
  SEND_EMAIL
  ADD_CONTACT
  ADD_TAG
  SEND_WEBHOOK
  GENERATE_AI_CONTENT
  NOTIFY
}

// ============================================================
// AI CONTENT HISTORY
// ============================================================

model AIContentHistory {
  id          String @id @default(cuid())
  workspaceId String

  type   AIContentType
  prompt String        @db.Text
  result String        @db.Text
  model  String

  // Usage metrics
  tokensUsed Int?

  // Reference
  postId String?

  createdAt DateTime @default(now())

  @@map("ai_content_history")
}

enum AIContentType {
  CAPTION
  HOOK
  HASHTAGS
  CTA
  HEADLINE
  STORY
  THREAD
  VIDEO_SCRIPT
  EMAIL
}

// ============================================================
// QUEUE JOBS
// ============================================================

model QueueJob {
  id   String    @id @default(cuid())
  type String
  payload Json
  status    JobStatus @default(PENDING)
  priority  Int       @default(5)

  attempts    Int @default(0)
  maxAttempts Int @default(3)

  scheduledAt  DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  failedAt     DateTime?
  errorMessage String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, scheduledAt])
  @@map("queue_jobs")
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}
